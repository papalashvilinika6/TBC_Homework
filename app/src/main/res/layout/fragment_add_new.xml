<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ibBackId"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:src="@drawable/back_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp">

    </androidx.appcompat.widget.AppCompatImageButton>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="84dp"
        android:text="@string/add_new_card"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ibBackId"
        app:layout_constraintStart_toEndOf="@id/ibBackId"
        app:layout_constraintTop_toTopOf="@id/ibBackId"
        app:layout_constraintVertical_bias="1.0">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCardId"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:src="@drawable/mc_card_example"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/ibBackId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp">

    </androidx.appcompat.widget.AppCompatImageView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCardholderLabelId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cardholder_name"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/ivCardId"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/cardholderInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvCardholderLabelId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCardNumberLabelId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/card_number"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cardholderInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCardNumberInputId"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:inputType="number"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvCardNumberLabelId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvExpiryLabelId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/expires"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/etCardNumberInputId"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etExpiryInputId"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvExpiryLabelId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cvvInput"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp">

    </androidx.appcompat.widget.AppCompatEditText>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCvvLabelId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cvv"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/tvExpiryLabelId"
        app:layout_constraintStart_toEndOf="@id/etExpiryInputId"
        android:layout_marginStart="16dp">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/cvvInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:inputType="numberPassword"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvCvvLabelId"
        app:layout_constraintStart_toEndOf="@id/etExpiryInputId"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="8dp" >

    </androidx.appcompat.widget.AppCompatEditText>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addCardButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/add_card"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#000000"
        android:background="@drawable/start_btn"
        app:layout_constraintTop_toBottomOf="@id/radioGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp">

    </androidx.appcompat.widget.AppCompatButton>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cvvInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp">

        <RadioButton
            android:id="@+id/radioMaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mastercard" />

        <RadioButton
            android:id="@+id/radioVisa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visa"
            android:layout_marginStart="24dp"/>
    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
