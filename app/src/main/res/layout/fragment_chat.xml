<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:paddingHorizontal="26dp">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBackId"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_back"
        android:background="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAdminAvatarId"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_admin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBackId"
        android:layout_marginStart="15dp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAdminNameId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="@id/ivAdminAvatarId"
        app:layout_constraintStart_toEndOf="@id/ivAdminAvatarId"
        android:layout_marginStart="10dp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAdminStatusId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/online"
        android:textSize="14sp"
        android:textColor="@color/green"
        app:layout_constraintTop_toBottomOf="@id/tvAdminNameId"
        app:layout_constraintStart_toStartOf="@id/tvAdminNameId" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnMenuId"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="@id/ivAdminAvatarId"
        app:layout_constraintBottom_toBottomOf="@id/ivAdminAvatarId"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/vHeaderDividerId"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/ivAdminAvatarId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatId"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/vHeaderDividerId"
        app:layout_constraintBottom_toTopOf="@id/etMessageInputId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etMessageInputId"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/type_your_messages_here"
        android:background="@drawable/button_shape"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSendId" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnSendId"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/send_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/etMessageInputId"
        app:layout_constraintTop_toTopOf="@id/etMessageInputId" />

</androidx.constraintlayout.widget.ConstraintLayout>
