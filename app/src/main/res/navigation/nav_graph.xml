<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">


    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.myapplication.presentation.ui.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_securityFragment"
            app:destination="@id/securityFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/securityFragment"
        android:name="com.example.myapplication.presentation.ui.security.SecurityFragment"
        android:label="SecurityFragment" />

</navigation>