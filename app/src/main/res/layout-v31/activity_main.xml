<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity=""
    android:paddingVertical="35dp"
    android:background="@color/white2">

    <FrameLayout
        android:id="@+id/childIdFrame"
        android:layout_width="355dp"
        android:layout_height="380dp"
        android:layout_gravity="center"
        android:background="@drawable/background_shape"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/backgroundImageId"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background">

        </ImageView>

        <ImageButton
            android:id="@+id/button1Id"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ellipse_button"
            android:layout_margin="21dp"
            android:src="@drawable/arrow"
            android:textColor="@color/white3">

        </ImageButton>

        <ImageButton
            android:id="@+id/button2Id"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ellipse_button"
            android:layout_margin="21dp"
            android:src="@drawable/archive"
            android:textSize="30sp"
            android:textColor="@color/white3"
            android:layout_gravity="end">

        </ImageButton>

        <FrameLayout
            android:id="@+id/framechildId"
            android:layout_width="331dp"
            android:layout_height="103dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/background_maldives"
            android:padding="10dp"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text1Id"
                android:layout_width="190dp"
                android:layout_height="29dp"
                android:text="@string/lication1_text"
                android:textColor="@color/white2"
                android:textSize="24sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp">

            </androidx.appcompat.widget.AppCompatTextView>

            <ImageView
                android:id="@+id/locationIconId"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/location_logo"
                android:layout_gravity="bottom"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="10dp">

            </ImageView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/locationId"
                android:layout_width="122dp"
                android:layout_height="21dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="12dp"
                android:text="@string/location_text"
                android:layout_marginStart="35dp"
                android:textSize="18sp"
                android:textColor="@color/white4"
                android:fontFamily="@font/roboto">

            </androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/priceId"
                android:layout_width="37dp"
                android:layout_height="19dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:text="@string/price"
                android:textSize="16sp"
                android:textColor="@color/white4"
                android:fontFamily="@font/roboto"
                android:layout_marginEnd="10dp">

            </androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dollarId"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="12dp"
                android:text="@string/_230"
                android:textSize="26sp"
                android:textColor="@color/white4"
                android:fontFamily="@font/roboto">

            </androidx.appcompat.widget.AppCompatTextView>

        </FrameLayout>

    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/childLinearId"
        android:layout_width="355dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:paddingTop="20dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/overviewId"
            android:layout_width="105dp"
            android:layout_height="27dp"
            android:text="@string/overview"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="@color/black">

        </androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/detailsId"
            android:layout_width="54dp"
            android:layout_height="19dp"
            android:text="@string/details"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:layout_marginStart="20dp">

        </androidx.appcompat.widget.AppCompatTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/child2LinearId"
        android:layout_width="355dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:paddingTop="20dp">

        <ImageView
            android:id="@+id/clockIconId"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/rectangle2_background"
            android:scaleType="center"
            android:src="@drawable/iconclock"
            android:layout_marginStart="5dp">

        </ImageView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/hoursId"
            android:layout_width="61dp"
            android:layout_height="21dp"
            android:text="@string/_8_hours"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/roboto"
            android:textColor="@color/white5">

        </androidx.appcompat.widget.AppCompatTextView>

        <ImageView
            android:id="@+id/weatherId"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/rectangle2_background"
            android:scaleType="center"
            android:src="@drawable/iconcloud"
            android:layout_marginStart="48dp">

        </ImageView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/weatherCId"
            android:layout_width="61dp"
            android:layout_height="21dp"
            android:text="@string/_16_c"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/roboto"
            android:textColor="@color/white5">

        </androidx.appcompat.widget.AppCompatTextView>

        <ImageView
            android:id="@+id/ratingiconId"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/rectangle2_background"
            android:scaleType="center"
            android:src="@drawable/vector"
            android:layout_marginStart="48dp">

        </ImageView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rating"
            android:layout_width="61dp"
            android:layout_height="21dp"
            android:text="@string/_4_5"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/roboto"
            android:textColor="@color/white5">

        </androidx.appcompat.widget.AppCompatTextView>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/descriptionId"
        android:layout_width="355dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:text="@string/description"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:layout_marginTop="10dp">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bookNowId"
        android:layout_width="373dp"
        android:layout_height="86dp"
        android:layout_gravity="center"
        android:background="@drawable/rectanglebutton"
        android:text="@string/book_now"
        android:textColor="@color/white"
        android:paddingHorizontal="120dp"
        android:drawableEnd="@drawable/sendicon"
        android:paddingBottom="20dp">

    </androidx.appcompat.widget.AppCompatButton>

</androidx.appcompat.widget.LinearLayoutCompat>