<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="26dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvGameNameId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="48dp"
        android:text="@string/game_name"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textCurrentPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="128dp"
        android:text="@string/current_x"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGameNameId">

    </androidx.appcompat.widget.AppCompatTextView>

     <androidx.recyclerview.widget.RecyclerView
         android:id="@+id/recyclerViewGameId"
         android:layout_width="match_parent"
         android:layout_height="425dp"
         android:layout_marginTop="24dp"
         app:layout_constraintTop_toBottomOf="@+id/textCurrentPlayer"
         tools:layout_editor_absoluteX="26dp">

     </androidx.recyclerview.widget.RecyclerView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textGameStatusId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="@color/red"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/recyclerViewGameId"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewGameId">

    </androidx.appcompat.widget.AppCompatTextView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnResetGameId"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/etext_shape"
        android:text="@string/reset_game"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textGameStatusId">

    </androidx.appcompat.widget.AppCompatButton>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackToHomeId"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginStart="244dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/etext_shape"
        android:text="@string/home"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textGameStatusId">

    </androidx.appcompat.widget.AppCompatButton>


</androidx.constraintlayout.widget.ConstraintLayout>